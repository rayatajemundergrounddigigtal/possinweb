{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "possin-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "possin.id", "custom_domain": true },
    { "pattern": "www.possin.id", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash"
  }
}
